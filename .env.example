# Leave VITE_API_BASE_URL empty in dev to use the Vite proxy (/api and /ws → gateway :8080).
# Set to the gateway URL for production builds or when not using the dev proxy.
# Required on Vercel/production so SSR can fetch market data for social previews (og:image, og:title).
# VITE_API_BASE_URL=https://api.yourdomain.com

# Public customer app URL (HTTPS in production). Required for og:url and og:image on affiliate links.
# Telegram/Facebook crawlers need a public HTTPS domain — localhost will not show previews.
VITE_APP_URL=https://www.supercash.ltd

# Admin dashboard lives in CMM-frontend-superadmin (default http://localhost:5174).
# P2P agent dashboard lives in CMM-frontend-p2p-admin (default http://localhost:5175).
# VITE_P2P_ADMIN_URL=http://localhost:5175
